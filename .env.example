# Google Maps API Key for Maps and Geocoding
GOOGLE_MAPS_PLATFORM_KEY=

# Lalamove API Keys (Production)
LALAMOVE_API_KEY=YOUR_LALAMOVE_API_KEY_HERE
LALAMOVE_API_SECRET=YOUR_LALAMOVE_API_SECRET_HERE
LALAMOVE_MARKET=TH

# POS Authentication
POS_PIN=123456

# Supabase Keys (Public)
VITE_SUPABASE_URL=YOUR_SUPABASE_URL_HERE
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Supabase SERVICE ROLE key — server only (Cloud Run env / Secret Manager), NEVER in the browser.
# Required since v1.5.0: Lalamove webhook status updates and LINE features call the DB with it.
SUPABASE_SERVICE_ROLE_KEY=
